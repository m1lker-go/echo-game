# ECHO server configuration. Copy to .env and set real values.
NODE_ENV=production
PORT=3001
CORS_ORIGIN=*

# Use either DATABASE_URL or the DB_* settings below.
# DATABASE_URL=postgresql://echo_user:REPLACE_WITH_PASSWORD@127.0.0.1:5432/echo_game_db

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=echo_game_db
DB_USER=echo_user
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DB_SSL=false
DB_POOL_MAX=10

# ECHO VK ID Web client (browser). Public app ID; never put secrets in Git.
VK_ID_APP_ID=54832804
# ECHO VK ID Android client: separately validates native SDK tokens on /auth/vk/android.
ECHO_VK_ANDROID_APP_ID=54853387

# ECHO VK Mini App (https://vk.ru/app54838920).
# Use its own "Protected key" ("Защищённый ключ"), NOT the Cat Fighting key.
# Never expose the key to the client or commit it to Git.
# This same ECHO protected key verifies both VK Mini App launch and VK payment notifications.
# Set the real key on the VPS before enabling purchases.
VK_MINI_APP_ID=54838920
VK_MINI_APP_SECRET=REPLACE_WITH_ECHO_VK_MINI_APP_PROTECTED_KEY

# ECHO premium pack through the EXISTING Cat Fighting Robokassa merchant.
# Set the SAME MerchantLogin / Password1 / Password2 values already used by Cat Fighting
# in the ECHO server process environment. Never put their values in GitHub or APK.
# The ECHO service has a separate process: Cat Fighting's .env is NOT auto-shared.
MERCHANT_LOGIN=
PASSWORD1=
PASSWORD2=
# Match the Cat Fighting merchant mode: false means real payments.
IS_TEST=true
# Optional per-ECHO overrides for managed deployments (not normally needed):
# ECHO_ROBO_MERCHANT_LOGIN=
# ECHO_ROBO_TEST_MODE=true
# ECHO_ROBO_TEST_PASSWORD1=
# ECHO_ROBO_TEST_PASSWORD2=
# ECHO_ROBO_PASSWORD1=
# ECHO_ROBO_PASSWORD2=

# Separate ECHO Google OAuth 2.0 Web application (not Cat Fighting).
# Redirect URI: https://cat-fight.ru/echo/api/auth/oauth/google/callback
# Store both on the VPS ONLY; never in the browser, APK or Git.
ECHO_GOOGLE_CLIENT_ID=
ECHO_GOOGLE_CLIENT_SECRET=

# Separate ECHO Yandex OAuth "For user authorization" application.
# Redirect URI: https://cat-fight.ru/echo/api/auth/oauth/yandex/callback
# Required scope: login:info
ECHO_YANDEX_CLIENT_ID=
ECHO_YANDEX_CLIENT_SECRET=

# ECHO proximity voice (self-hosted LiveKit), disabled unless all 3 are set.
# Put actual credentials in the VPS .env only; never commit them to Git.
# First configure Nginx/TLS for voice.cat-fight.ru and start LiveKit.
ECHO_LIVEKIT_URL=
ECHO_LIVEKIT_API_URL=http://127.0.0.1:7880
ECHO_LIVEKIT_API_KEY=
ECHO_LIVEKIT_API_SECRET=
