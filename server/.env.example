# ECHO server configuration. Copy to .env and set real values.
NODE_ENV=production
PORT=3001
CORS_ORIGIN=*

# Use either DATABASE_URL or the DB_* settings below.
# DATABASE_URL=postgresql://echo_user:REPLACE_WITH_PASSWORD@127.0.0.1:5432/echo_game_db

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=echo_game_db
DB_USER=echo_user
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DB_SSL=false
DB_POOL_MAX=10
